[Unit]
Description=Treasure Hunt game server
After=network.target

[Service]
User=admin
WorkingDirectory=/opt/treasurehunt/server
Environment=PORT=80
ExecStart=/usr/bin/make serve
Restart=always
RestartSec=2

# Lets waitress bind to port 80 without running the whole service as root
AmbientCapabilities=CAP_NET_BIND_SERVICE

# TODO once they exist:
#   Environment=HUNT_STATE=/var/lib/treasurehunt/state.json WEB_DIR=/opt/treasurehunt/web
#   StateDirectory=treasurehunt

[Install]
WantedBy=multi-user.target
